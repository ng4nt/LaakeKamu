<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: health data never leaves the device. -->
    <!-- Dose reminders (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact reminder alarms. 33+: granted at install and can't be revoked
         (a Play policy use case: a medication reminder). 31-32: the user can revoke it. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- supportsRtl="false": the UI is Finnish only, so it stays left to right on a phone set to
         an RTL language; otherwise the rows mirror, the progress Canvas doesn't, and the bidi
         rules move "?" and "!" to the start of the texts. -->
    <application
        android:name=".LaakeKamuApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.LaakeKamu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LaakeKamu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reached only through the scheduler's explicit PendingIntents: no intent-filter. -->
        <receiver
            android:name=".reminders.AlarmReceiver"
            android:exported="false" />
    </application>

</manifest>