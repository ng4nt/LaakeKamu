<!-- The adaptive icon foreground (108dp, safe zone a 66dp circle): the Figma icon inset to ~46dp,
     so its corners stay inside the safe zone: (108 − 46) / 2 / 108 ≈ 28.7 % per side. A fraction,
     not dp: a dp inset is absolute, and 2 × 101dp left nothing of the 108dp layer. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_app_following"
    android:inset="28.7%" />
