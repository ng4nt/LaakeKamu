<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LaakeKamu" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The launch theme: splashBg with the fi-rs-following icon, then the app
         theme. installSplashScreen() in MainActivity switches to it. -->
    <style name="Theme.LaakeKamu.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LaakeKamu</item>
    </style>
</resources>
