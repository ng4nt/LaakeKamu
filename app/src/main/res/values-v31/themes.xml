<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- As in values/, plus the title "LääkeKamu" as the branding image at the bottom: the
         system splash (API 31+) can't show text under the icon. -->
    <style name="Theme.LaakeKamu.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.LaakeKamu</item>
    </style>
</resources>
